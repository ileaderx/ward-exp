# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ward-exp?retryWrites=true&w=majority"

# Long random string used to sign the login cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me"

# The single account that can sign in
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me"

# Currency shown on amounts (ISO code: USD, EUR, SAR, AED, IQD, ...)
NEXT_PUBLIC_CURRENCY="USD"

# Time zone used for "today", "this month" and report ranges
APP_TIMEZONE="Asia/Riyadh"
